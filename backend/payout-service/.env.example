# Copy this file to ".env" and adjust the values. NEVER commit ".env".
PORT=8086
# Same value as "jwt.secret" in account-service and as JWT_SECRET in the other services
# (plain text, NOT Base64, at least 32 characters)
JWT_SECRET=change-me-secret-at-least-32-characters
# Same key as INTERNAL_KEY in payment-service (the payout-service sends it to /internal/**)
INTERNAL_KEY=change-me-at-least-16-characters

PAYMENT_SERVICE_URL=http://localhost:8085

DB_HOST=localhost
DB_PORT=5432
DB_NAME=payout_db
DB_USER=postgres
DB_PASSWORD=change-me
