# Copy this file to ".env" and adjust the values. NEVER commit ".env".
PORT=8080
# Same value as "jwt.secret" in account-service and in all other services
# (plain text, NOT Base64, at least 32 characters)
JWT_SECRET=change-me-secret-at-least-32-characters

# Allowed browser origins, separated by commas
CORS_ORIGINS=http://localhost:4200

# false: forward /api/auth/login as /api/auth/login (current account-service)
# true : forward /api/auth/login as /auth/login (services without the /api prefix)
STRIP_API_PREFIX=false

# Rate limiting on sign in / sign up (per IP)
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
# Global rate limiting (per IP)
RATE_WINDOW_MS=60000
RATE_MAX=300

# Services (change these if a port is already used on your PC)
ACCOUNT_SERVICE_URL=http://localhost:8081
PROFILE_SERVICE_URL=http://localhost:8082
EVENT_SERVICE_URL=http://localhost:8083
REGISTRATION_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
PAYOUT_SERVICE_URL=http://localhost:8086
NOTIFICATION_SERVICE_URL=http://localhost:8087